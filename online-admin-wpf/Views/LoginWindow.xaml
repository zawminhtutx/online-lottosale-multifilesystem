<Window x:Class="OnlineLotto.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lotto Admin — Login" Width="980" Height="640" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Bar}" Padding="48">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding ServerUrl}" Foreground="{StaticResource OnBar}" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                    <TextBlock Text="Online API" Foreground="{StaticResource OnBarDim}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Lotto Admin" Foreground="{StaticResource OnBar}" FontSize="34" FontWeight="Bold"/>
                    <TextBlock Text="Login, Dashboard, Sale — offline အရောင်း UI အတိုင်း" Foreground="{StaticResource OnBarDim}"
                               FontSize="16" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="28"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource PanelBorder}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Padding="10">
                <StackPanel Width="380" VerticalAlignment="Center" Margin="20">
                    <TextBlock Text="Login ဝင်ရန်" Style="{StaticResource Heading}" Margin="0,0,0,18"/>
                    <TextBlock Text="Server" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                    <TextBlock Text="Username" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                    <TextBlock Text="Password" Style="{StaticResource Caption}"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14"/>
                    <Border Style="{StaticResource ErrorBox}" Margin="0,0,0,14"
                            Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Padding="18,12"
                            Click="LoginButton_Click">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="ဝင်မည်"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Busy}" Value="True">
                                            <Setter Property="Text" Value="ဝင်နေသည်…"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
