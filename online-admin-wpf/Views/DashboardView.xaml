<UserControl x:Class="OnlineLotto.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RibbonGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="4,4,4,2"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="MinHeight" Value="104"/>
        </Style>
        <Style x:Key="RibbonGroupName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="RibbonButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InfoBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bar}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource RibbonGroup}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="ဖိုင် / အပါတ်စဥ်" Style="{StaticResource RibbonGroupName}"/>
                                <Border Padding="8,4,10,4" VerticalAlignment="Center">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="ဖိုင်" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Visibility="{Binding ShowFolder, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FileText}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                                                   Visibility="{Binding ShowFolder, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOpenFile}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Text="အပါတ်စဥ်" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,10,12,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Terms}" SelectedItem="{Binding SelectedTerm}"
                                                  DisplayMemberPath="Description" FontSize="16" FontWeight="Bold" Padding="8,4" MinWidth="240" Margin="0,10,0,0"
                                                  HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RibbonGroup}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" Style="{StaticResource RibbonGroupName}"/>
                                            <ItemsControl ItemsSource="{Binding Buttons}" Focusable="False" Margin="2,2,2,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource RibbonButton}" MinWidth="86" MaxWidth="130" Padding="8,6,8,4"
                                                                ToolTip="{Binding Label}"
                                                                Command="{Binding DataContext.PressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="28"
                                                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                                <TextBlock Text="{Binding Label}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <UniformGrid Columns="4" Margin="0,0,0,16"
                         Visibility="{Binding ShowOverview, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Agents" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Agents}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Users" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Users}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Today sales" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding TodaySales}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Open terms" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding OpenTerms}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Bad}" Margin="0,0,0,10"
                       Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>
            <TextBlock Text="Slip delete requests" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"
                       Visibility="{Binding CanModerateDeletes, Converter={StaticResource BoolToVis}}"/>
            <ListView ItemsSource="{Binding DeleteRequests}" BorderThickness="0" Margin="0,0,0,16"
                      Visibility="{Binding CanModerateDeletes, Converter={StaticResource BoolToVis}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="User" Width="120" DisplayMemberBinding="{Binding Username}"/>
                        <GridViewColumn Header="Slip" Width="160" DisplayMemberBinding="{Binding SlipNo}"/>
                        <GridViewColumn Header="Term" Width="180" DisplayMemberBinding="{Binding TermDescription}"/>
                        <GridViewColumn Header="Amount" Width="100" DisplayMemberBinding="{Binding NetAmount}"/>
                        <GridViewColumn Header="" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Approve" Style="{StaticResource SuccessButton}" Padding="10,4" Margin="0,0,8,0"
                                                Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Reject" Style="{StaticResource PlainButton}" Padding="10,4"
                                                Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
