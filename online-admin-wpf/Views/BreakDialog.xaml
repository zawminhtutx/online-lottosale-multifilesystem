<Window x:Class="OnlineLotto.Wpf.Views.BreakDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ဘရိတ် ပြင်မည်" Style="{StaticResource AppWindow}" Background="{StaticResource Panel}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border BorderBrush="{StaticResource Accent}" BorderThickness="0,4,0,0">
        <StackPanel Margin="26,20">
            <TextBlock Text="ဘရိတ် ပြင်မည်" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TermText" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
            <TextBlock Text="ဂဏန်းတစ်ကွက်ကို စလစ်အားလုံးပေါင်း အများဆုံး ယူနစ်။ 0 = ကန့်သတ်ချက်မရှိ။"
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <ItemsControl x:Name="FieldList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"/>
                            <TextBox Text="{Binding Units, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumberBox}" FontSize="17"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="ErrorBox" Style="{StaticResource ErrorBox}" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="မလုပ်ပါ" Style="{StaticResource PlainButton}" IsCancel="True" MinWidth="110" Margin="0,0,10,0"/>
                <Button Content="သိမ်းမည်" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="110" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
