<Window x:Class="OnlineLotto.Wpf.Views.UserFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account" Style="{StaticResource AppWindow}" Background="{StaticResource Panel}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border BorderBrush="{StaticResource Accent}" BorderThickness="0,4,0,0">
        <StackPanel Margin="26,20">
            <TextBlock x:Name="HeadingText" Style="{StaticResource Heading}" Margin="0,0,0,14"/>
            <TextBlock Text="Username" Style="{StaticResource Caption}"/>
            <TextBox x:Name="UsernameBox" FontSize="16" MaxLength="30" Margin="0,0,0,12"/>
            <TextBlock Text="အမည်" Style="{StaticResource Caption}"/>
            <TextBox x:Name="NameBox" FontSize="16" MaxLength="50" Margin="0,0,0,12"/>
            <TextBlock x:Name="RoleLabel" Text="Role" Style="{StaticResource Caption}"/>
            <ComboBox x:Name="RoleBox" FontSize="16" Padding="8,5" Margin="0,0,0,12"/>
            <TextBlock Text="Password" Style="{StaticResource Caption}"/>
            <PasswordBox x:Name="PasswordBox" FontSize="16" Padding="8,5" Margin="0,0,0,4"/>
            <TextBlock x:Name="PasswordHint" Text="Password အနည်းဆုံး 6 လုံး" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
            <Border x:Name="ErrorBox" Style="{StaticResource ErrorBox}" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="မလုပ်တော့ပါ" Style="{StaticResource PlainButton}" IsCancel="True" MinWidth="110" Margin="0,0,10,0"/>
                <Button Content="သိမ်းမည်" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="110" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
