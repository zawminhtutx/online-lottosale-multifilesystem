<Window x:Class="OnlineLotto.Wpf.Views.PrizeSetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="အလျော်အဆ" Style="{StaticResource AppWindow}" Width="920" Height="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelBorder}" Margin="12,12,12,0" Padding="12,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="NewButton" Content="အသစ်" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="New_Click"/>
                    <Button Content="ပိတ်မည်" Style="{StaticResource PlainButton}" Padding="14,8" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="Bold" Text="အလျော်အဆ"/>
                    <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Text="ဆုကြေးအဆ (×) — နှစ်ချက်နှိပ်ပြီး ပြင်ပါ"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" x:Name="ErrorText" Margin="16,8" Foreground="{StaticResource Bad}"/>
        <ListView x:Name="List" Margin="12" FontSize="15" MouseDoubleClick="List_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="အမည်" Width="180" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="အဆများ" Width="420" DisplayMemberBinding="{Binding RatesText}"/>
                    <GridViewColumn Header="တွဒ် ×" Width="80" DisplayMemberBinding="{Binding Twod}"/>
                    <GridViewColumn Header="ထိုးသား" Width="80" DisplayMemberBinding="{Binding Users}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
