<UserControl x:Class="OnlineLotto.Wpf.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource PanelBorder}" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="320">
                    <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="6,3" Margin="0,0,0,6">
                        <TextBlock Text="စာရင်း" Foreground="{StaticResource OnAccent}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <ListBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReport}" Height="90" FontSize="15"/>
                </StackPanel>
                <StackPanel Width="260" Margin="14,0,0,0">
                    <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="6,3" Margin="0,0,0,6">
                        <TextBlock Text="အပါတ်စဥ်" Foreground="{StaticResource OnAccent}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <ComboBox ItemsSource="{Binding Terms}" SelectedItem="{Binding SelectedTerm}" FontSize="15" Padding="8,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Description}"/>
                                    <TextBlock Text="  (" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Text=")" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <Grid Width="290" Margin="14,0,0,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button Style="{StaticResource PrimaryButton}" Padding="12,8" Command="{Binding ViewCommand}" Content="View"/>
                    <Button Grid.Column="2" Style="{StaticResource PlainButton}" Padding="12,8" Click="DotView_Click" Content="Dot View"/>
                    <Button Grid.Column="2" Grid.Row="2" Style="{StaticResource PlainButton}" Padding="12,8" Click="ReportView_Click" Content="Report View"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource InfoBg}" Padding="14,8">
                    <TextBlock FontWeight="Bold" FontSize="16" Foreground="{StaticResource Accent}" Text="{Binding Title}"/>
                </Border>
                <ListView ItemsSource="{Binding SummaryRows}" FontSize="15" BorderThickness="0"
                          Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVis}}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Username" Width="140" DisplayMemberBinding="{Binding Username}"/>
                            <GridViewColumn Header="Tickets" Width="80" DisplayMemberBinding="{Binding Tickets}"/>
                            <GridViewColumn Header="Gross" Width="110" DisplayMemberBinding="{Binding Gross}"/>
                            <GridViewColumn Header="Net" Width="110" DisplayMemberBinding="{Binding Net}"/>
                            <GridViewColumn Header="Payout" Width="110" DisplayMemberBinding="{Binding Payout}"/>
                            <GridViewColumn Header="Profit" Width="110" DisplayMemberBinding="{Binding Profit}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <ListView ItemsSource="{Binding PayoutRows}" FontSize="15" BorderThickness="0"
                          Visibility="{Binding ShowPayout, Converter={StaticResource BoolToVis}}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="User" Width="130" DisplayMemberBinding="{Binding Username}"/>
                            <GridViewColumn Header="Slip" Width="150" DisplayMemberBinding="{Binding SlipNo}"/>
                            <GridViewColumn Header="Type" Width="70" DisplayMemberBinding="{Binding BetType}"/>
                            <GridViewColumn Header="ပေါက်ဂဏန်း" Width="100" DisplayMemberBinding="{Binding Number}"/>
                            <GridViewColumn Header="Unit" Width="80" DisplayMemberBinding="{Binding Units}"/>
                            <GridViewColumn Header="အဆ" Width="80" DisplayMemberBinding="{Binding Multiplier}"/>
                            <GridViewColumn Header="အလျော်" Width="120" DisplayMemberBinding="{Binding WinAmount}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <ListView x:Name="BoardList" FontFamily="{StaticResource MonoFont}" FontSize="13" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowLedger, Converter={StaticResource BoolToVis}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="22"/>
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding Message}" Foreground="{StaticResource Bad}" Margin="4,8,0,0"
                   Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>
    </Grid>
</UserControl>
