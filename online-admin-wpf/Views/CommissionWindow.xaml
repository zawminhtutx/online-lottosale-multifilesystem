<Window x:Class="OnlineLotto.Wpf.Views.CommissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ကော်မရှင်" Style="{StaticResource AppWindow}" Width="720" Height="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelBorder}" Margin="12,12,12,0" Padding="12,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="ပိတ်မည်" Style="{StaticResource PlainButton}" Padding="14,8" IsCancel="True" Click="Close_Click"/>
                <TextBlock FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Text="ကော်မရှင်"/>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" x:Name="HintText" Margin="16,8" Foreground="{StaticResource Muted}"
                   Text="စာရင်းကို နှစ်ချက်နှိပ်ပြီး % ပြင်ပါ"/>
        <ListView x:Name="List" Margin="12" FontSize="15" MouseDoubleClick="List_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Username" Width="160" DisplayMemberBinding="{Binding Username}"/>
                    <GridViewColumn Header="Role" Width="90" DisplayMemberBinding="{Binding Role}"/>
                    <GridViewColumn Header="ကော်မရှင် %" Width="280" DisplayMemberBinding="{Binding Percents}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
