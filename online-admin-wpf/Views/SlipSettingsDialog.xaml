<Window x:Class="OnlineLotto.Wpf.Views.SlipSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slip Printer Settings" Style="{StaticResource AppWindow}" Background="{StaticResource Panel}"
        Width="600" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Row" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource Accent}" BorderThickness="0,4,0,0">
        <StackPanel Margin="24,16,24,18">
            <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,12" Text="Slip Printer Settings"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Print Width" Style="{StaticResource Row}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="Width80" Content="80mm" GroupName="w" Margin="0,0,24,0"/>
                    <RadioButton x:Name="Width58" Content="58mm" GroupName="w"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Font Size" Style="{StaticResource Row}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="FontSmall" Content="Small" GroupName="f" Margin="0,0,24,0"/>
                    <RadioButton x:Name="FontNormal" Content="Normal" GroupName="f" Margin="0,0,24,0"/>
                    <RadioButton x:Name="FontLarge" Content="Large" GroupName="f"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Left Align Margin (mm)" Style="{StaticResource Row}"/>
                <TextBox x:Name="MarginBox" Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left" Padding="6,3" Margin="0,4" TextAlignment="Right"/>
                <TextBlock Grid.Row="3" Text="Digit Item Extra Margin (mm)" Style="{StaticResource Row}" TextWrapping="Wrap"/>
                <TextBox x:Name="ItemMarginBox" Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left" Padding="6,3" Margin="0,4" TextAlignment="Right"/>
                <TextBlock Grid.Row="4" Text="Layout" Style="{StaticResource Row}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TwoColumn" Content="Two Column" GroupName="c" Margin="0,0,24,0"/>
                    <RadioButton x:Name="SingleColumn" Content="Single Column" GroupName="c"/>
                </StackPanel>
            </Grid>
            <UniformGrid Columns="2" Margin="0,10,0,0">
                <CheckBox x:Name="BoldBox" Content="Bold Print" Margin="0,4"/>
                <CheckBox x:Name="GroupBox" Content="Group Print" Margin="0,4"/>
                <CheckBox x:Name="AmountBox" Content="Amount line" Margin="0,4"/>
                <CheckBox x:Name="TotalBox" Content="Total line" Margin="0,4"/>
            </UniformGrid>
            <Separator Margin="0,14"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Company Name — admin သာ server ပေါ် သိမ်းပါမည်။ Logo / width သည် ဒီစက်မှာ သိမ်းပါမည်။"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Logo" Style="{StaticResource Row}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Border Width="64" Height="64" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Background="{StaticResource Bg}">
                        <Grid>
                            <TextBlock x:Name="NoLogoText" Text="No Logo" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="LogoImage" Stretch="Uniform" Margin="3"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PlainButton}" Padding="10,4" Click="BrowseLogo_Click" Content="Browse"/>
                            <Button x:Name="RemoveLogoButton" Style="{StaticResource PlainButton}" Padding="10,4" Margin="8,0,0,0" Click="RemoveLogo_Click" Content="Remove"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Width (mm)" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                            <TextBox x:Name="LogoWidthBox" Width="60" Padding="6,2" TextAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Header Company Name" Style="{StaticResource Row}"/>
                <TextBox x:Name="CompanyBox" Grid.Row="1" Grid.Column="1" Padding="8,4" Margin="0,4" FontSize="15"/>
                <TextBlock Grid.Row="2" Text="Footer Text" Style="{StaticResource Row}"/>
                <TextBox x:Name="FooterBox" Grid.Row="2" Grid.Column="1" Padding="8,4" Margin="0,4" FontSize="15"/>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="မလုပ်ပါ" Style="{StaticResource PlainButton}" IsCancel="True" MinWidth="110" Margin="0,0,10,0"/>
                <Button Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="120" Click="Save_Click" Content="Save"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
