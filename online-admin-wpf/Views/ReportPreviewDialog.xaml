<Window x:Class="OnlineLotto.Wpf.Views.ReportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report View" Style="{StaticResource AppWindow}" Width="760" Height="720" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy" Style="{StaticResource PlainButton}" Padding="14,6" Margin="0,0,8,0" Click="Copy_Click"/>
                    <Button Content="Exit" Style="{StaticResource PlainButton}" Padding="14,6" IsCancel="True" Click="Exit_Click"/>
                </StackPanel>
                <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="12" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="PreviewText" FontFamily="Consolas, Courier New" FontSize="14" Foreground="{StaticResource Fg}"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
