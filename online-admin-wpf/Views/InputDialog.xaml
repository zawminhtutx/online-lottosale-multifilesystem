<Window x:Class="OnlineLotto.Wpf.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Background="{StaticResource Panel}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border BorderBrush="{StaticResource Accent}" BorderThickness="0,4,0,0">
        <StackPanel Margin="26,20">
            <TextBlock x:Name="HeadingText" Style="{StaticResource Heading}" Margin="0,0,0,12"/>
            <TextBlock x:Name="LabelText" Style="{StaticResource Caption}"/>
            <TextBox x:Name="ValueBox" FontSize="17" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="မလုပ်ပါ" Style="{StaticResource PlainButton}" IsCancel="True" MinWidth="110" Margin="0,0,10,0"/>
                <Button Content="သိမ်းမည်" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="110" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
