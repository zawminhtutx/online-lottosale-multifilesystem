<Window x:Class="OnlineLotto.Wpf.Views.PrizeAssignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="အလျော်အဆတွဲ" Style="{StaticResource AppWindow}" Background="{StaticResource Panel}"
        Width="430" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border BorderBrush="{StaticResource Accent}" BorderThickness="0,4,0,0" Padding="24,20">
        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource Heading}" Margin="0,0,0,14"/>
            <TextBlock Text="အလျော်အဆ ရွေးပါ" Style="{StaticResource Caption}"/>
            <ComboBox x:Name="SetBox" DisplayMemberPath="Name" FontSize="16" Padding="8,6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="မလုပ်တော့ပါ" Style="{StaticResource PlainButton}" IsCancel="True" MinWidth="110" Margin="0,0,10,0"/>
                <Button Content="တွဲမည်" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="110" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
