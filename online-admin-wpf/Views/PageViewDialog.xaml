<Window x:Class="OnlineLotto.Wpf.Views.PageViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Page View" Style="{StaticResource AppWindow}" Width="1120" Height="820" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Background="#FF5F6670">
        <Border DockPanel.Dock="Top" Background="White" Padding="16,8" BorderBrush="#FFD6DCE5" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="|&lt;" Style="{StaticResource PlainButton}" IsEnabled="False" Padding="9,4"/>
                    <Button Content="&lt;" Style="{StaticResource PlainButton}" IsEnabled="False" Padding="9,4" Margin="5,0,0,0"/>
                    <TextBlock Text="Page 1 of 1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/>
                    <Button Content="&gt;" Style="{StaticResource PlainButton}" IsEnabled="False" Padding="9,4"/>
                    <Button Content="&gt;|" Style="{StaticResource PlainButton}" IsEnabled="False" Padding="9,4" Margin="5,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="WindowHeading" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="#FFE5F0FF" Padding="16,8" BorderBrush="#FFD6DCE5" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="🖨 Print" Style="{StaticResource PrimaryButton}" Padding="16,7" Click="Print_Click"/>
                    <Button Content="Send ▾" Style="{StaticResource PlainButton}" Padding="16,7" Margin="10,0,0,0" Click="Send_Click"/>
                    <Button Content="Close" Style="{StaticResource PlainButton}" Padding="16,7" Margin="10,0,0,0" IsCancel="True" Click="Close_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="စာရွက်" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="90" SelectedIndex="0" Padding="6,3"><ComboBoxItem Content="A4"/></ComboBox>
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="20,0,6,0"/>
                    <ComboBox x:Name="ZoomBox" Width="84" SelectedIndex="1" Padding="6,3" SelectionChanged="ZoomBox_SelectionChanged">
                        <ComboBoxItem Content="75%" Tag="0.75"/>
                        <ComboBoxItem Content="90%" Tag="0.90"/>
                        <ComboBoxItem Content="100%" Tag="1"/>
                        <ComboBoxItem Content="125%" Tag="1.25"/>
                    </ComboBox>
                    <TextBlock Text="Printer  (Print dialog)" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="36" Background="#FF5F6670">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border x:Name="Paper" Width="794" MinHeight="1123" Background="White" Padding="40" SnapsToDevicePixels="True">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.42"/></Border.Effect>
                    <Border.LayoutTransform><ScaleTransform x:Name="PageZoom" ScaleX="0.9" ScaleY="0.9"/></Border.LayoutTransform>
                    <StackPanel x:Name="PageContent"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
