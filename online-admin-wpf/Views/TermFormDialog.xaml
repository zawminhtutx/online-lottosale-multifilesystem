<Window x:Class="OnlineLotto.Wpf.Views.TermFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Background="{StaticResource Panel}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border BorderBrush="{StaticResource Accent}" BorderThickness="0,4,0,0">
        <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,20">
                <TextBlock x:Name="HeadingText" Style="{StaticResource Heading}" Margin="0,0,0,6"/>
                <TextBlock Text="Settings" Style="{StaticResource Caption}" Margin="0,0,0,12"/>

                <TextBlock Text="အပါတ်စဥ်အမည်" Style="{StaticResource Caption}"/>
                <TextBox x:Name="NameBox" FontSize="17" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="အမျိုးအစား" Style="{StaticResource Caption}"/>
                        <ComboBox x:Name="GameBox" FontSize="16" Padding="8,6">
                            <ComboBoxItem Content="2D" IsSelected="True"/>
                            <ComboBoxItem Content="3D"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ယူနစ်စျေး (Unit Price)" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="PriceBox" Style="{StaticResource NumberBox}" FontSize="17"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Break (ဂဏန်းတစ်ကွက် အများဆုံး ယူနစ် · 0 = ကန့်သတ်မရှိ)" Style="{StaticResource Caption}"/>
                <TextBox x:Name="BreakBox" Style="{StaticResource NumberBox}" FontSize="17" Margin="0,0,0,14"/>

                <TextBlock Text="ထိုးကြေးဖွင့်ချိန်" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,12">
                    <TextBox x:Name="OpenTimeBox" DockPanel.Dock="Right" Width="88" Style="{StaticResource NumberBox}" FontSize="16" Padding="8,6"/>
                    <DatePicker x:Name="OpenDate" FontSize="15" Padding="6,4" Margin="0,0,8,0"/>
                </DockPanel>
                <TextBlock Text="ပိတ်ချိန်" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,12">
                    <TextBox x:Name="CloseTimeBox" DockPanel.Dock="Right" Width="88" Style="{StaticResource NumberBox}" FontSize="16" Padding="8,6"/>
                    <DatePicker x:Name="CloseDate" FontSize="15" Padding="6,4" Margin="0,0,8,0"/>
                </DockPanel>
                <TextBlock Text="ဂဏန်းထွက်ချိန်" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,12">
                    <TextBox x:Name="DrawTimeBox" DockPanel.Dock="Right" Width="88" Style="{StaticResource NumberBox}" FontSize="16" Padding="8,6"/>
                    <DatePicker x:Name="DrawDate" FontSize="15" Padding="6,4" Margin="0,0,8,0"/>
                </DockPanel>
                <TextBlock Text="ရက်စွဲ + နာရီ:မိနစ် (ဥပမာ 09:30)။ ဗလာထားရင် မသတ်မှတ်ပါ။"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Border x:Name="ErrorBox" Style="{StaticResource ErrorBox}" Visibility="Collapsed" Margin="0,0,0,8">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="မလုပ်ပါ" Style="{StaticResource PlainButton}" IsCancel="True" MinWidth="110" Margin="0,0,10,0"/>
                    <Button x:Name="SaveButton" Content="သိမ်းမည်" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="110" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
