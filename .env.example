TURSO_DATABASE_URL=libsql://onlinelotto-<your-org>.turso.io
TURSO_AUTH_TOKEN=

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
PORT=3000
# Extra browser origins allowed to call the API. Empty is fine when the site and API share a host
# (Render): the page's own Origin is allowed; Flutter (no Origin) is allowed. Comma-separated if
# the web app is on another host. Do not use * in production.
CORS_ORIGIN=
MAX_ITEMS_PER_TICKET=1000
LOGIN_RATE_LIMIT=20

# Close-time ledger email (00-99 and 000-999). Leave SMTP_HOST empty to skip sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
